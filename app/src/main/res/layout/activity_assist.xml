<?xml version="1.0" encoding="utf-8"?>
<!--
    AssistActivity 的"背景滚动 TextView"布局：
    - 整个 Activity 的窗口就是一个大 TextView，外面包 ScrollView 用于滚动查看
    - 实时显示 logcat 子进程的 stdout 流
    - 同时还承接 Activity 内部原本写在 logDialog / showErrorDialog 中的日志与异常
    - 底部一行操作按钮：跳到最底部、清屏
    - [已移除] 不再有"自动跟随"逻辑，新日志不会自动滚到底部
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#101418">

    <ScrollView
        android:id="@+id/scrollViewAssistBg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/tvAssistBg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:textIsSelectable="true"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:textColor="#A9B7C6"
            android:gravity="top|start"
            android:lineSpacingExtra="2dp" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="6dp"
        android:background="#1B2026"
        android:gravity="end">

        <Button
            android:id="@+id/btnBgClearLog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:text="清屏" />

        <Button
            android:id="@+id/btnBgScrollToBottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="↓ 跳到最新" />
    </LinearLayout>
</LinearLayout>